  "lines": [
    {
      "id": "intro-bill-01",
      "text": "Take your time. The mountain isn't going anywhere. Neither am I, apparently.",
      "clip": "assets/audio/narrator/intro-bill-01-15d91878be65.mp3"
    },
    {
      "id": "intro-bill-02",
      "text": "A small light, a very tall climb. Let's see how far it goes.",
      "clip": "assets/audio/narrator/intro-bill-02-5842137a66e5.mp3"
    },
    {
      "id": "intro-bill-03",
      "text": "No need for a grand plan. The next ledge will do.",
      "clip": "assets/audio/narrator/intro-bill-03-8d970eaa5420.mp3"
    },
    {
      "id": "intro-bill-04",
      "text": "We'll start with one jump. Most regrettable decisions begin just as simply.",
      "clip": "assets/audio/narrator/intro-bill-04-bafce19425ca.mp3"
    },
    {
      "id": "intro-bill-05",
      "text": "Up we go. The floor has had quite enough of our company.",
      "clip": "assets/audio/narrator/intro-bill-05-9e8544f89e0c.mp3"
    },
    {
      "id": "intro-bill-06",
      "text": "Welcome back. I kept the mountain exactly where you left it.",
      "clip": "assets/audio/narrator/intro-bill-06-79027a95a520.mp3"
    }
  ]
}
