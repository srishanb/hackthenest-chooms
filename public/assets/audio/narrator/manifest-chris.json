  "lines": [
    {
      "id": "intro-chris-01",
      "text": "Take your time. The mountain isn't going anywhere. Neither am I, apparently.",
      "clip": "assets/audio/narrator/intro-chris-01-ac2eb950242a.mp3"
    },
    {
      "id": "intro-chris-02",
      "text": "A small light, a very tall climb. Let's see how far it goes.",
      "clip": "assets/audio/narrator/intro-chris-02-cd9ea77b518e.mp3"
    },
    {
      "id": "intro-chris-03",
      "text": "No need for a grand plan. The next ledge will do.",
      "clip": "assets/audio/narrator/intro-chris-03-f10c3a3db909.mp3"
    },
    {
      "id": "intro-chris-04",
      "text": "We'll start with one jump. Most regrettable decisions begin just as simply.",
      "clip": "assets/audio/narrator/intro-chris-04-8c9b22e627e3.mp3"
    },
    {
      "id": "intro-chris-05",
      "text": "Up we go. The floor has had quite enough of our company.",
      "clip": "assets/audio/narrator/intro-chris-05-1cb9c2ddbea0.mp3"
    },
    {
      "id": "intro-chris-06",
      "text": "Welcome back. I kept the mountain exactly where you left it.",
      "clip": "assets/audio/narrator/intro-chris-06-18ad953bdacd.mp3"
    }
  ]
}
