# Shared env var names (no values). Copy to .env.local and fill in keys shared privately by the team.
# Never commit .env.local. Never give a key a VITE_ prefix: Vite ships VITE_* variables to the browser.

# Dev server port. scripts/wt.sh writes a stable value per worktree; set it by hand only in codebase/ (main).
PORT=

# Used only by build-time scripts in tools/narrator/ (never by the game at runtime).
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
